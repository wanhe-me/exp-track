# 后端运行配置
# 运行环境：development | production
# 生产部署务必改为 production——development 下会额外放行私网来源的 CORS，
# 且日志与错误细节更宽松。此文件会被 build:release 原样带进部署包。
NODE_ENV=development
HOST=127.0.0.1
PORT=15180

# 中国时区
TZ=Asia/Shanghai

# CORS（前端地址）
CORS_ORIGIN=http://127.0.0.1:15173

# 后端日志阈值：debug | info | warn | error | silent（默认 warn，仅输出告警与错误）
# 排查启动/迁移过程时临时改为 info 再恢复
# LOG_LEVEL=warn

# MySQL（需 Docker 或既有实例；docker compose up -d 拉起本地 MySQL 8.0）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=exp_track
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=exp_track
MYSQL_CONNECTION_LIMIT=10

# 领域配置（PRD 第 5 章，可选，留空使用默认值）
# SOON7_THRESHOLD=7
# SOON30_THRESHOLD=30
# TIMELINE_RANGE_DAYS=90
