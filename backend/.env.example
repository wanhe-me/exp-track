# 后端运行配置
NODE_ENV=development
HOST=127.0.0.1
PORT=15180

# 中国时区
TZ=Asia/Shanghai

# CORS（前端地址）
CORS_ORIGIN=http://127.0.0.1:15173

# 数据库类型：sqlite（快速部署，默认）/ mysql（稳定部署，需 Docker 或既有实例）
DB_TYPE=sqlite

# SQLite（快速部署）
# 数据库文件路径，相对于 backend 目录
SQLITE_PATH=./data/exp-track.db

# MySQL（稳定部署，DB_TYPE=mysql 时生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=exp_track
MYSQL_PASSWORD=exp_track123
MYSQL_DATABASE=exp_track
MYSQL_CONNECTION_LIMIT=10

# 领域配置（PRD 第 5 章，可选，留空使用默认值）
# SOON7_THRESHOLD=7
# SOON30_THRESHOLD=30
# TIMELINE_RANGE_DAYS=90
