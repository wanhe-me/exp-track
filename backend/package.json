{
  "name": "exp-track-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "会员订阅追踪 - 后端服务",
  "scripts": {
    "dev": "nodemon --watch src -e ts,json --exec \"tsx src/bootstrap/server.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mysql2": "^3.11.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}