# 本地环境变量模板：复制为 .env 后生效（.env 已被 .gitignore 忽略）
#
# 一份 .env 同时服务两件事：
#   1. 前端 Vite（只读取 VITE_ 前缀的变量）
#   2. docker compose（仅本地用 Docker 起 MySQL 时相关）
#
# ---- 前端（Vite）----
# 开发：后端在本机 15180
# 生产同源部署：改为 "/"（nginx 反代 /api），见 .env.production
VITE_API_BASE_URL=http://127.0.0.1:15180

# ---- docker compose（可选）----
# 后端 MySQL 为局域网既有实例时，以下变量无需填写；仅在用本仓库 compose 起库时才需要。
# 后端连接信息在 backend/.env 中配置，见 backend/.env.example。

# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=exp_track
MYSQL_USER=exp_track
MYSQL_PASSWORD=change_me
MYSQL_PORT=13306

# phpMyAdmin
PHPMYADMIN_PORT=18080
